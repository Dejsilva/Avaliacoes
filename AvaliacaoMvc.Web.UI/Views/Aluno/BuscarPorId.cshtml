@model AlunoModel

@{
    var alunoPremium = ViewBag.AlunoPremium;
}

<h2>Dados Por Id</h2>


<form asp-controller="Aluno" asp-action="BuscarPorId" method="post">
    <label>idAluno</label>
    <input type="number" name="idAluno" />
    <button type="submit">Buscar</button>
</form>

<table border="1" cellpadding="8" cellspacing="0" class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Peso</th>
            <th>Altura</th>
            <th>Data de Nascimento</th>
            <th>Idade</th>
        </tr>
    </thead>
    <tbody>

   
        @if (Model != null)
        {
                <tr>
                    <td>@Model.Nome</td>
                    <td>@Model.Peso</td>
                    <td>@Model.Altura</td>
                    <td>@Model.DataNascimento.ToString("dd/MM/yyyy")</td>
                    <td>@Model.idade</td>
                </tr>
            
        }
        
    </tbody>

</table>
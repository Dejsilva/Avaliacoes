@model AlunoModel

<div class="row">
    <div class="col-md-4">
        <!-- FORMULÁRIO 1: Apenas para Buscar o Aluno -->
        <form asp-controller="Aluno" asp-action="Editar" method="get">
            <div class="form-group mb-3">
                <label>Digite o ID do Aluno:</label>
                <input type="number" name="idAluno" class="form-control" value="@Context.Request.Query["idAluno"]" />
                <button type="submit" class="btn btn-secondary mt-2">Buscar</button>
            </div>
        </form>

        <hr />

        <!-- FORMULÁRIO 2: Só exibe e edita se o aluno foi encontrado -->
        @if (Model != null)
        {
            <form asp-controller="Aluno" asp-action="Editar" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- O ID oculto está aqui e vai manter o ID buscado para o POST -->
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-2">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group mb-2">
                    <label asp-for="Peso" class="control-label"></label>
                    <input asp-for="Peso" class="form-control" />
                    <span asp-validation-for="Peso" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Altura" class="control-label"></label>
                    <input asp-for="Altura" class="form-control" />
                    <span asp-validation-for="Altura" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Salvar Alterações" class="btn btn-primary" />
                </div>
            </form>
        }
        else if (Context.Request.Query["idAluno"].Count > 0)
        {
            <!-- Mensagem caso o usuário tenha buscado um ID que não existe -->
            <div class="alert alert-danger">Aluno não encontrado!</div>
        }
    </div>
</div>

